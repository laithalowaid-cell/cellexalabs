# Orders are saved for the private orders page at /admin/orders.
#
# BLOB_READ_WRITE_TOKEN is added by Vercel when a private Blob store is
# connected to the project. Without it (local development) orders are written
# to .data/orders instead.
BLOB_READ_WRITE_TOKEN=
# Password for /admin/orders and the private orders feed (GET /api/orders).
ORDERS_ADMIN_PASSWORD=
